# The Angular app reads its API base URL from src/environments/environment.ts
# (development) and environment.prod.ts (production build), not from this file --
# Angular inlines the environment at build time.
#
# This template documents the value those files should carry per environment:
#   development : http://localhost:8000/api/v1
#   production  : /api/v1   (same-origin, behind a reverse proxy)
API_BASE_URL=http://localhost:8000/api/v1

# Fixed NBS middle rates used for language-aware display currency.
# SR displays RSD, EN displays USD, and DE displays EUR.
RSD_EUR_RATE=117.3707
RSD_USD_RATE=100.7906
