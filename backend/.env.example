DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@db:5432/ecommerce
# Origin(s) allowed by CORS. Comma-separated if the API serves several front ends.
FRONTEND_ORIGIN=http://localhost:4200
# Public base of this API. Uploaded product images are stored as relative paths
# and served with this prefix, so the SPA (a different origin) can load them.
API_PUBLIC_URL=http://localhost:8000
# CHANGE THIS. The app refuses to start with this example value once
# COOKIE_SECURE=true, and warns about it otherwise.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
ADMIN_EMAIL=admin@luxecommerce.com
ADMIN_PASSWORD=Admin123!
STANDARD_SHIPPING_COST=500
EXPRESS_SHIPPING_COST=1200
RSD_EUR_RATE=117.3707
RSD_USD_RATE=100.7906
# Returns the password-reset token in the API response (no mailer is wired up yet).
# Local development only - must stay false in production.
EXPOSE_RESET_TOKEN=false
# Set true once the API is served over HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false
